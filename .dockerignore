!cli.py
!pyproject.toml
!tests
!cloud
**/__pycache__
**/*.mp4
!tests/data/*.mp4
# Re-excluded after the allows above: credentials, footage and outputs stay
# out even when they sit inside an allowed folder.
**/*.env
**/footage
**/out
**/eval/cache
**/.venv*
**/*_blurred*
