# Real Ego camera footage never enters git.
footage/
*.mp4
*.mov
*.avi
*.mkv
*.m4v
*.webm
!tests/data/*.mp4

# Python
.venv/
.venv-eval/
__pycache__/
*.py[cod]
*.egg-info/

# Build output
build/*/
dist/
*.spec.bak

# Local run output
*_blurred/
*_blurred_v*/
footage_blurred*/
out/

# PyInstaller output
dist/

# Evaluation caches derived from real footage
eval/cache/

# Run logs and batch reports. A batch report names source files and
# carries every audit record, so it belongs beside the output, not in git.
*_run.log
*_err.log
*_report.json
sweep_*.log
