# Copy to /root/faceblur.env on the instance. The real file holds keys and
# never goes in git (cloud/*.env is ignored).
S3_ENDPOINT=https://hcm04.vstorage.vngcloud.vn
S3_ACCESS_KEY=
S3_SECRET_KEY=
BUCKET=faceblur
DATA=/data
# Workers per card. Set from the first measurement on the instance.
WORKERS=6
# What the run does beyond masking faces: the check and quarantine, and
# optionally --second-chance 1.
RUN_ARGS=--quarantine
POWEROFF=1
# The rclone root to read from and write to. Default vs:$BUCKET; a plain
# directory path makes it a local remote (the tests use that).
#REMOTE=vs:faceblur
# 1 makes every machine take videos one at a time from a shared queue in the
# bucket instead of a fixed SHARD split.
#QUEUE=0
# Seconds a queued video stays claimed by a machine before another may take it.
#LEASE=1800
# 1 lets a queue-mode machine delete its own server when the queue is empty.
#SELF_DELETE=0
# The GreenNode server name this machine runs as, for SELF_DELETE.
#GN_SERVER_NAME=
